{
  "name": "agri-dms-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:memory": "tsx scripts/dev-memory.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed": "tsx scripts/seed.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "seed-psgc": "tsx scripts/seed-psgc.ts",
    "integrity": "tsx scripts/integrity.ts",
    "create-indexes": "tsx scripts/create-indexes.ts",
    "db-role": "tsx scripts/db-role.ts",
    "data-dictionary": "tsx scripts/data-dictionary.ts",
    "seed-boundaries": "tsx scripts/seed-boundaries.ts",
    "import-workbook": "tsx scripts/import-workbook.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@turf/simplify": "^7.4.0",
    "ajv": "^8.20.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "proj4": "^2.22.0",
    "shapefile": "^0.6.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/proj4": "^2.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
