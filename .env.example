# Copy to .env. Never commit .env. Production values come from the host's secret store, as
# docs/deployment.md describes.

# The hosted database. Keep the real value only in .env: it contains a password.
# Not needed for `npm test` or `npm run dev:memory`, which use a temporary local database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
# Defaults to agri_dev outside production, and must be set in production.
# MONGODB_DB=agri_dev

# NODE_ENV=development
# HOST=127.0.0.1
# PORT=8000

# Signs sign-in tokens. Optional in development; production needs a random value of 50+ characters.
# JWT_SIGNING_KEY=

# --- Production only ---
# The address people open, with no path: the Netlify site. Plain HTTP is sent here.
# PUBLIC_ORIGIN=https://agri.example.gov.ph
# Proxies in front of the server. At least 1 in production, for the one that ends HTTPS.
# TRUSTED_PROXY_COUNT=0
# Serve the built frontend from this server too (absolute path). Not needed with Netlify.
# STATIC_DIR=
# Any extra origins allowed to sign in.
# CSRF_TRUSTED_ORIGINS=

# --- Files ---
# Uploads and error reports. They hold personal data, so keep this private.
# PRIVATE_FILES_DIR=
# IMPORT_FILE_RETENTION_DAYS=30

# --- Map (ADR-0016). The default OSM tiles are for low-volume internal use only. ---
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_DEFAULT_CENTER=121.97,13.4
# MAP_DEFAULT_ZOOM=10

# --- npm run dev:memory only. Chooses the local admin's password instead of generating one. ---
# DEV_ADMIN_PASSWORD=
