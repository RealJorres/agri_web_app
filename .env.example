# Copy to .env (make up does this automatically). Values below are for LOCAL DEV ONLY.
# Never commit .env. Production values come from the deployment's secret store.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789abcdef0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Database (PostGIS) ---
POSTGRES_DB=agri
POSTGRES_USER=agri
POSTGRES_PASSWORD=agri-dev-password
DATABASE_URL=postgis://agri:agri-dev-password@db:5432/agri

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Files ---
# Private storage for uploaded workbooks and error reports (ADR-0009)
PRIVATE_MEDIA_ROOT=/var/lib/agri/private
IMPORT_FILE_RETENTION_DAYS=30

# --- Map (ADR-0016). The default OSM tiles are for low-volume internal use only. ---
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_DEFAULT_CENTER=121.97,13.4
# MAP_DEFAULT_ZOOM=10

# --- Demo (make seed-demo; DEBUG only). Synthetic users share this password. ---
DEMO_PASSWORD=demo-only-Passw0rd-not-for-production
